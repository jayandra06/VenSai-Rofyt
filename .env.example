# ── VenSai Venture Admin (apps/admin) — admin.vensailabs.in ──

# Central MongoDB (required) — one cluster URI, one admin portal database
MONGODB_URI=
MONGODB_DB_NAME=vensai_admin

# CRM → admin provisioning (must match CRM venture .env)
VENTURE_PROVISIONING_SECRET=

# Login session signing (defaults to VENTURE_PROVISIONING_SECRET)
SESSION_SECRET=

ADMIN_PUBLIC_HOST=admin.vensailabs.in

# Optional: create a new M0 cluster per venture from the admin UI
# ATLAS_PUBLIC_KEY=
# ATLAS_PRIVATE_KEY=
# ATLAS_GROUP_ID=
# ATLAS_REGION=AP_SOUTH_1

# ── ROFYT ERP (apps/erp) ──
# VENTURE_PROVISIONING_SECRET=
