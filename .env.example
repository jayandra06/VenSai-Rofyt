# ── VenSai Venture Admin (apps/admin) — admin.vensailabs.in ──

# MongoDB cluster (shared today; one logical DB per venture on this cluster)
MONGODB_URI=
# Platform catalog DB name (venture registry)
MONGODB_PLATFORM_DB=vensai_admin_platform
# Prefix for per-venture DBs → e.g. vensai_venture_rofyt
MONGODB_VENTURE_DB_PREFIX=vensai_venture_

# CRM → admin provisioning (must match CRM venture .env)
VENTURE_PROVISIONING_SECRET=

# Login session signing (defaults to VENTURE_PROVISIONING_SECRET)
SESSION_SECRET=

# Optional public host label for health JSON
ADMIN_PUBLIC_HOST=admin.vensailabs.in

# Phase 2 — Atlas Admin API (auto cluster per venture; not active until implemented)
# ATLAS_AUTO_CLUSTER=1
# ATLAS_PUBLIC_KEY=
# ATLAS_PRIVATE_KEY=
# ATLAS_GROUP_ID=

# ── ROFYT ERP (apps/erp) ──
# VENTURE_PROVISIONING_SECRET=
# DATABASE_URL=
