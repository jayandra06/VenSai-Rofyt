# Per-app machine credential (CRM stores encrypted copy per target; must match CRM venture .env)
VENTURE_PROVISIONING_SECRET=

# Admin portal — PostgreSQL (separate from VenSai CRM)
DATABASE_URL=

# Signs admin login cookies (defaults to VENTURE_PROVISIONING_SECRET if unset)
SESSION_SECRET=

