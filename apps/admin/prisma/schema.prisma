generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VentureAdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  ventureKey   String
  email        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ventureKey, email])
  @@index([email])
}
